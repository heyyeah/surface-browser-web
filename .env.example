# Environment variable reference for the API server (server/index.js).
#
# Copy this file to .env; the server loads it at start-up. Every line below is
# commented out and shows the default, so an empty .env gives the defaults.
#
# Precedence for the settings that can also be changed in the in-app settings
# panel (image search, GenAI provider/sizing, display toggles): the saved
# settings file wins, then the environment variable, then the default.
# Variables that are not shown in the settings panel are environment-only.
#
# Booleans accept 1/true/yes/on (anything else is false) unless noted.
# Time values are milliseconds. Sizes are bytes unless noted.

# ---------------------------------------------------------------------------
# Server basics
# ---------------------------------------------------------------------------

# Port the API server listens on.
# PORT=8788
# Interface to bind. Default 127.0.0.1 (this machine only; the Vite proxy and ngrok reach it).
# 0.0.0.0 lets the whole network use the API and its provider keys. Keep 127.0.0.1 behind a proxy.
# BIND_HOST=127.0.0.1
# Serve a built client (the dist/ folder) from this process. Unset = off (Vite serves it in dev).
# SERVE_STATIC_DIR=
# Where the settings panel saves its overrides (JSON). Default: server/settings.local.json.
# SETTINGS_FILE_PATH=./server/settings.local.json

# ---------------------------------------------------------------------------
# Image search
# ---------------------------------------------------------------------------

# Provider: ddg (no key needed), serper, brave or custom. "duckduckgo" is accepted as ddg.
# If unset, it is inferred: a custom endpoint, else a Serper key, else a Brave key, else ddg.
# IMAGE_SEARCH_PROVIDER=ddg
# Endpoint of your own search service (used when the provider is custom).
# IMAGE_SEARCH_ENDPOINT=
# API key for Serper (IMAGE_SEARCH_PROVIDER=serper).
# SERPER_API_KEY=
# API key for Brave Search (IMAGE_SEARCH_PROVIDER=brave).
# BRAVE_SEARCH_API_KEY=
# Longest search query kept, in characters. Longer queries are truncated, not rejected.
# SEARCH_QUERY_MAX_CHARS=200
# Number of image-search results kept in the in-memory cache. 0 disables it.
# SEARCH_CACHE_MAX=500
# How long a cached search result is reused. Cache hits never count against the spend caps.
# SEARCH_CACHE_TTL_MS=86400000

# ---------------------------------------------------------------------------
# Page extraction and Playwright
# ---------------------------------------------------------------------------

# Timeout for each upstream page or image fetch.
# REQUEST_TIMEOUT_MS=15000
# Largest upstream page or image response the server will read.
# MAX_RESPONSE_BYTES=10485760
# Redirects followed per upstream fetch.
# MAX_REDIRECTS=5
# Comma-separated list of exact hostnames the server may fetch pages and images from.
# Unset allows any public host. Private and internal addresses are always blocked.
# ALLOWED_TARGET_HOSTS=
# Render pages in a headless browser to catch script-loaded images. Anything except 0 means on.
# If Playwright is not installed or fails, extraction falls back to plain HTML.
# PLAYWRIGHT_ENABLED=1
# Browser renders allowed at once.
# PLAYWRIGHT_CONCURRENCY_MAX=1
# Past it, a page waits this long for a render (at most this many waiting),
# then gets its plain-HTML result.
# PLAYWRIGHT_WAIT_MS=8000
# PLAYWRIGHT_WAIT_MAX=3
# How long an extraction result is cached and reused.
# EXTRACT_CACHE_TTL_MS=86400000
# Most extraction results kept in the cache.
# EXTRACT_CACHE_MAX_ENTRIES=500

# ---------------------------------------------------------------------------
# Image proxy and caches
# ---------------------------------------------------------------------------

# Directory for an on-disk cache of proxied images, shared by all visitors. Unset = no disk cache.
# IMAGE_PROXY_CACHE_DIR=
# Total size limit of that cache; least recently used files are deleted first. 0 disables it.
# IMAGE_PROXY_CACHE_MAX_BYTES=2147483648
# How long a cached image is kept. 0 disables the cache.
# IMAGE_PROXY_CACHE_TTL_MS=86400000
# Directory for an on-disk cache of whole text-to-image batches, so the same prompt typed twice
# is generated once. Unset = no cache, identical prompts are generated again.
# GENAI_PROMPT_CACHE_DIR=
# Total size limit of the prompt cache. 0 disables it.
# GENAI_PROMPT_CACHE_MAX_BYTES=536870912
# How long a cached prompt result is kept. 0 disables the cache.
# GENAI_PROMPT_CACHE_TTL_MS=86400000
# Directory where generated images are saved when GENAI_SAVE_IMAGES_TO_DISK is on.
# GENAI_IMAGE_DIR_PATH=./generated-images
# Images held in memory for the client to fetch (generated and imported images).
# Oldest go first once either the count or the bytes is over.
# GENAI_IMAGE_CACHE_MAX=3000
# GENAI_IMAGE_CACHE_MAX_BYTES=314572800
# Pool images held in memory, shared by every sphere that shows them.
# GENAI_POOL_MEMORY_MAX_BYTES=157286400
# How long those in-memory images are kept.
# GENAI_IMAGE_CACHE_TTL_MS=1800000
# Finished generation results held in memory so a repeat request can reuse them.
# GENAI_RESULT_CACHE_MAX=50
# How long a held result is reused. Default: the same as GENAI_IMAGE_CACHE_TTL_MS.
# GENAI_RESULT_CACHE_TTL_MS=1800000
# Quality (1-100) of the WebP copy sent to browsers that accept WebP instead of the original PNG.
# 0 sends the original. Only the response changes; the stored image is untouched.
# GENAI_DELIVERY_WEBP_QUALITY=0
# Largest remote image downloaded when a web or search image is imported as a variation source.
# Larger images are resized after download, not refused, up to this download limit.
# GENAI_SOURCE_IMPORT_MAX_BYTES=20971520

# ---------------------------------------------------------------------------
# GenAI providers
# ---------------------------------------------------------------------------

# Provider: drawthings, a1111, fal, custom (relay is an alias of custom).
# If unset: custom when GENAI_ENDPOINT is set, otherwise GenAI is disabled.
# GENAI_PROVIDER=
# Generic endpoint (older style). Used when no provider-specific endpoint below is set.
# GENAI_ENDPOINT=
# Endpoint of a Draw Things server. Built-in fallback: http://127.0.0.1:7860
# GENAI_DRAWTHINGS_ENDPOINT=
# Endpoint of an Automatic1111-compatible (sdapi) server. Built-in fallback: http://127.0.0.1:8022
# GENAI_A1111_ENDPOINT=
# Endpoint of your own generation relay (GENAI_PROVIDER=custom).
# GENAI_CUSTOM_ENDPOINT=
# fal.ai API key (GENAI_PROVIDER=fal). GENAI_API_KEY is tried first, then FAL_KEY.
# GENAI_API_KEY=
# FAL_KEY=
# Base URL of the fal API.
# GENAI_FAL_BASE_URL=https://fal.run
# fal model used for text-to-image.
# GENAI_FAL_TEXT_MODEL=fal-ai/flux/schnell
# fal model used for image-to-image variations.
# GENAI_FAL_IMAGE_MODEL=fal-ai/flux/dev/image-to-image
# Largest source image (before encoding) sent inline to fal for a variation. Bigger ones are refused.
# FAL_VARY_MAX_SOURCE_BYTES=4194304
# Smallest image width fal accepts; requests are raised to at least this (rounded up to a multiple of 64).
# FAL_MIN_IMAGE_WIDTH=640
# Smallest image height fal accepts; requests are raised to at least this.
# FAL_MIN_IMAGE_HEIGHT=512
# Largest requested image area in pixels, to cap per-megapixel cost. 0 removes the cap. Default is 768 x 768.
# GENAI_MAX_REQUEST_PIXELS=589824
# Largest JSON response read from a generation provider.
# GENAI_RESPONSE_MAX_BYTES=52428800
# Save generated images as files in GENAI_IMAGE_DIR_PATH.
# GENAI_SAVE_IMAGES_TO_DISK=1
# Delete saved images automatically (see retention below).
# GENAI_CLEANUP_IMAGES=1
# Days to keep saved images (0-3650). 0 deletes images saved before the current server start.
# GENAI_IMAGE_RETENTION_DAYS=0
# Time allowed for one generation call (1000-600000).
# GENAI_TIMEOUT_MS=120000
# Generations that may wait behind the ones running. Over the limit new requests are turned away as busy.
# GENAI_QUEUE_MAX_PENDING=2
# Generations run at once. Default: 3 on fal (parallel, billed per image), 1 otherwise.
# GENAI_PARALLEL_JOBS=3
# Block prompts (and speech transcripts) containing terms from server/museum-safe-blocklist.txt.
# GENAI_MUSEUM_SAFE=0
# Longest GenAI prompt kept, in characters. Longer prompts are truncated, not rejected.
# GENAI_PROMPT_MAX_CHARS=1000
# Generation jobs remembered for progress polling. Oldest are dropped past this.
# GENAI_PROGRESS_JOBS_MAX=500

# ---------------------------------------------------------------------------
# GenAI sizing and variation
# ---------------------------------------------------------------------------

# Images per batch (1-15).
# GENAI_COUNT=5
# Generated image width in pixels (64-2048).
# GENAI_WIDTH=512
# Generated image height in pixels (64-2048).
# GENAI_HEIGHT=512
# Sampling steps (1-150). Empty = do not send a value and let the provider decide.
# GENAI_STEPS=8
# 1 = use the known recommended steps for the loaded local model (FLUX.2 Klein: 4, Moss: 30).
# GENAI_STEPS_RECOMMENDED=0
# Classifier-free guidance scale (0.1-30). Empty = do not send a value.
# GENAI_CFG_SCALE=
# Draw Things guidance-embed value (0.1-30), sent only to the drawthings provider.
# GENAI_DRAWTHINGS_GUIDANCE_EMBED=5
# Lowest variation strength (0-1). A batch ramps from the lower of min/max to the higher.
# Lower values stay closer to the source image.
# GENAI_VARIATION_STRENGTH_MIN=0.95
# Highest variation strength (0-1).
# GENAI_VARIATION_STRENGTH_MAX=1
# Seed handling for variations: fresh (new random seed each time) or fixed (reuse the seed).
# GENAI_VARY_SEED_MODE=fresh
# Emoji used to perturb a variation, space-separated. One is picked at random.
# For the text payload, override a phrase with emoji:phrase (one word), for example "🧊:glacial".
# GENAI_VARY_MODIFIERS=🧊 🌶️ 🦄 🎆 🍦 🧀 🌹 😎 🪩 🦦 🦘 ❄️ 🌊 🌕 🌲 🍌 💡 🕯️ 🚿
# How often an emoji is picked: off, batch (one per request) or per-image (one per image).
# GENAI_VARY_MODIFIER_MODE=per-image
# How the emoji is used: replace (the modifier is the whole prompt), append (added to the prompt)
# or auto (replace for a local edit model, else the prompt plus every emoji in the chain).
# GENAI_VARY_MODIFIER_STYLE=replace
# Append style: how many of the newest emoji in the chain go in the prompt (1-6).
# GENAI_VARY_PROMPT_EMOJI=2
# Words sent for each emoji, over the built-in ones: "emoji text" per line or separated by ";".
# GENAI_VARY_MODIFIER_TEXTS=🦦 otter, playful wet fur;🦘 kangaroo, Australian outback
# What is sent: text (a short descriptive phrase for the emoji) or emoji (the raw character).
# GENAI_VARY_MODIFIER_PAYLOAD=text

# ---------------------------------------------------------------------------
# GenAI pool
# ---------------------------------------------------------------------------

# Read-only directory of pre-generated images that is drawn from before generating new ones.
# Unset = no pool, every request is generated live.
# GENAI_POOL_DIR=./data/curated/v1
# Fresh (newly generated) images mixed into each batch when a pool is in use: minimum per batch.
# GENAI_POOL_FRESH_MIN=1
# Fresh images per batch: maximum. A random number between min and max is used.
# GENAI_POOL_FRESH_MAX=2
# Writable directory where new images from preset bookmark prompts are kept and reused.
# Unset = nothing is kept. Must be writable by the server.
# GENAI_POOL_GROW_DIR=./data/pool-grown
# Images kept per pool key before that key stops growing.
# GENAI_POOL_GROW_MAX_PER_KEY=8
# Daily images that grow the pool, charged to one shared budget instead of the visitor's own
# limit (the global cap still applies). 0 = charged to the visitor.
# GENAI_POOL_GROW_DAILY_CAP=300
# Generations of a bookmark lineage that are kept: 1 = the bookmark's own images, 2 = their
# variations, and so on.
# GENAI_POOL_GROW_MAX_ROUND=4
# File that records images removed in the pool review page. Default: next to the pool directory,
# named "<pool dir>.suppressed.json".
# GENAI_POOL_SUPPRESS_FILE=

# ---------------------------------------------------------------------------
# Speech to text
# ---------------------------------------------------------------------------

# Provider: builtin (runs a Whisper model inside the server, needs @huggingface/transformers),
# whisper (whisper.cpp or mlx-whisper HTTP server), openai, custom, or off/none/disabled.
# STT_PROVIDER=builtin
# Base URL of the whisper server, or the full URL for custom (raw audio in, {text} out).
# STT_ENDPOINT=
# Path on the whisper server that accepts the audio upload.
# STT_WHISPER_PATH=/inference
# API key for the openai provider. If empty, OPENAI_API_KEY is used.
# STT_API_KEY=
# OPENAI_API_KEY=
# OpenAI transcription model.
# STT_OPENAI_MODEL=whisper-1
# Model for the builtin provider. Unset tries Xenova/whisper-base, then Xenova/whisper-tiny.en.
# The first run downloads the model into the Hugging Face cache.
# STT_BUILTIN_MODEL=
# Use only models already on disk for the builtin provider; never download.
# STT_BUILTIN_LOCAL_ONLY=0
# Largest audio upload accepted.
# STT_MAX_AUDIO_BYTES=10485760
# Transcriptions at once; more get a 503. Built-in Whisper keeps a CPU core busy.
# STT_CONCURRENCY_MAX=1
# Time allowed for one transcription.
# STT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Limits and spend guard
# ---------------------------------------------------------------------------

# Requests per IP per window on the expensive routes (page extraction, image search, generation,
# source import, speech to text). 0 = no limit.
# RATE_LIMIT_REQUESTS_PER_WINDOW=0
# Older name for RATE_LIMIT_REQUESTS_PER_WINDOW, used only if that one is unset.
# RATE_LIMIT_PER_MINUTE=
# Length of the rate-limit window.
# RATE_LIMIT_WINDOW_MS=60000
# Separate, larger limit for cheap reads (proxied images, generation job polling).
# Default: 30 times RATE_LIMIT_REQUESTS_PER_WINDOW, or 0 (no limit) when that is 0.
# RATE_LIMIT_READ_REQUESTS_PER_WINDOW=
# Most distinct client addresses tracked by the rate limiter at once.
# RATE_LIMIT_MAX_TRACKED_IPS=5000
# Page extractions and source imports running at once across all visitors. 0 = no limit.
# SCRAPE_CONCURRENCY_MAX=3
# Extractions and imports one client address may run at once.
# SCRAPE_CONCURRENCY_PER_CLIENT=2
# Proxied image requests running at once across all visitors. 0 = no limit.
# IMAGE_PROXY_CONCURRENCY_MAX=6
# Proxied image requests one client address may run at once.
# IMAGE_PROXY_CONCURRENCY_PER_CLIENT=4
# Daily cap on paid generated images, all visitors together. Counts images, not requests.
# 0 = unlimited. With all four caps at 0 the spend guard is off and writes nothing.
# GENAI_DAILY_IMAGE_CAP=0
# Daily cap on generated images per client address. 0 = unlimited.
# GENAI_DAILY_IMAGES_PER_IP=0
# Daily cap on paid search queries, all visitors together. 0 = unlimited.
# SEARCH_DAILY_QUERY_CAP=0
# Daily cap on search queries per client address. 0 = unlimited.
# SEARCH_DAILY_QUERIES_PER_IP=0
# An IPv6 /48 (one site or cloud tenant, 65536 /64s) may spend this many per-IP
# caps a day across all its /64s. 0 = no /48 limit.
# SPEND_IPV6_48_FACTOR=4
# Assumed cost per generated image (USD), used only for the estimated-spend figures.
# GENAI_USD_PER_IMAGE=0.003125
# Assumed cost per search query (USD).
# SEARCH_USD_PER_QUERY=0.001
# File where the spend guard keeps its daily counters.
# SPEND_STATE_PATH=./server/spend-state.json
# Delay before changed counters are written to disk.
# SPEND_PERSIST_DELAY_MS=2000
# Spend log file. Default: spend.log in the same folder as the API query log.
# SPEND_LOG_FILE=
# Emergency stop: while this file exists, generation and image search answer 503. Delete it to resume.
# KILL_SWITCH_PATH=./server/KILL_SWITCH
# How often the kill-switch file is re-checked.
# KILL_SWITCH_CACHE_MS=5000
# Largest JSON request body (a size string such as 1mb). Every JSON route posts
# a few KB; images and audio use their own raw parsers.
# JSON_BODY_LIMIT=1mb

# ---------------------------------------------------------------------------
# Hardening for a public host
# ---------------------------------------------------------------------------

# Every default here suits a developer's own machine. On a public host also: bind to loopback
# behind the proxy (BIND_HOST=127.0.0.1), set the rate limits and daily spend caps (both off by
# default; see their sections), and run the service with NODE_ENV=production.
#
# Reverse proxies in front of the server: 0 trusts none, 1 trusts one hop (for example Caddy or nginx).
# Also accepts true/false or an Express trust-proxy spec such as loopback or a subnet list.
# Set it correctly: client addresses, rate limits and the local-only admin checks depend on it.
# TRUST_PROXY=0
# Comma-separated list of origins allowed to call the API cross-site. Unset allows localhost pages only.
# CORS_ALLOWED_ORIGINS=https://vr.example.org
# Hide the settings panel and its API (they answer 404). Recommended on a public host.
# HIDE_SETTINGS=0
# Token that lets a remote caller change settings (sent as the x-settings-token header).
# Without it, settings can be changed only from the server machine itself.
# SETTINGS_TOKEN=
# Allow the screen-capture route. Set 0 to turn it off completely.
# SCREENSHOT_ENABLED=1
# Token required for screen capture from a remote device. Unset = only the server machine itself may capture.
# SCREENSHOT_TOKEN=
# Directory where captures are written.
# SCREENSHOT_DIR_PATH=./screenshots
# Largest capture upload accepted.
# SCREENSHOT_MAX_BYTES=16777216
# The JavaScript-page renderer (PLAYWRIGHT_ENABLED) opens whatever page a visitor names in
# Chromium, with Chromium's sandbox on. Ubuntu 24.04+ refuses that sandbox its user namespace
# unless an AppArmor profile allows it: an unconfined profile for the Playwright browser path
# containing just `userns,`. Without one the renderer fails to start and pages fall back to plain
# HTML. It is on whenever Playwright is installed; set PLAYWRIGHT_ENABLED=0 if you do not need it.
# Accept diagnostic reports posted by the client. These are unauthenticated and written to disk;
# set 0 on a public host.
# XR_DIAG_ENABLED=1
# Size at which the diagnostics log is rotated (one previous file is kept).
# XR_DIAG_MAX_BYTES=20971520
# Longest diagnostic line kept; longer ones are cut.
# XR_DIAG_MAX_LINE_CHARS=8192

# ---------------------------------------------------------------------------
# Logging and diagnostics
# ---------------------------------------------------------------------------

# Log every API query (search, extraction, generation) to the console and a file.
# LOG_API_QUERIES=1
# API query log file. Default: server/query.log.
# LOG_API_QUERIES_FILE=./server/query.log
# Client diagnostics log file. Default: server/xr-diag.log.
# XR_DIAG_LOG_FILE=./server/xr-diag.log

# ---------------------------------------------------------------------------
# Admin and monitoring
# ---------------------------------------------------------------------------

# The admin pages /admin/live, /admin/queries, /admin/pool and /admin/generated answer only to
# requests from the server machine itself (use an SSH tunnel); /admin/pool also needs a pool
# directory configured.
# File where the live monitor keeps per-day visitor counts (numbers and country codes only).
# LIVE_STATS_PATH=./server/live-stats.json
# Days of pages, searches and prompts kept for /admin/queries (0-7, 0 = off).
# QUERY_LOG_DAYS=3
# File for that log.
# QUERY_LOG_PATH=./server/queries.jsonl
# Where the admin pages link a query to, to open it in the app.
# PUBLIC_APP_ORIGIN=http://localhost:5173
# Optional .mmdb country database for per-country counts on the live page. Unset = no countries.
# GEOIP_COUNTRY_DB=
# Idle time after which the sphere stops auto-advancing through generated (paid) images.
# 0 disables the stop (0-86400000).
# AUTO_ADVANCE_IDLE_TIMEOUT_MS=300000
# The same stop for free hops (web and search spheres) (0-86400000).
# AUTO_ADVANCE_FREE_IDLE_TIMEOUT_MS=3600000
# Show the status footer in the client.
# SHOW_STATUS_FOOTER=1
# Show the list of loaded images in the client.
# SHOW_IMAGE_LIST=1
# Make generated images in that list clickable links.
# GENAI_IMAGE_LIST_LINKS=1
# Hand that carries the VR wrist panel: left or right.
# WRIST_PANEL_HAND=left

# ---------------------------------------------------------------------------
# Client build flags (Vite)
# ---------------------------------------------------------------------------

# 1 builds in the developer tools (tunnel parameters, state labels, debug buttons); 0 builds the
# normal interface. Read at build or dev-server start, not by the API server.
# DEV=0
# Where the Vite dev server proxies /api. Dev server only.
# VITE_API_TARGET=http://127.0.0.1:8788
# Comma-separated hostnames the Vite dev server accepts, besides localhost and IP addresses.
# Unset accepts ngrok's domains; list another tunnel's host here ("true" is not accepted). Dev server only.
# VITE_ALLOWED_HOSTS=
